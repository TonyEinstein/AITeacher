# ===== AI Teacher 生产环境变量模板 =====
# 复制为 .env.prod 并填写真实值，切勿提交到 Git

# ---- PostgreSQL ----
DB_USER=ait_prod
DB_PASSWORD=请替换为强密码
DB_NAME=ai_teacher

# ---- Redis ----
REDIS_PASSWORD=请替换为强密码

# ---- MinIO（自托管对象存储；正式商用建议切换腾讯云 COS）----
MINIO_ACCESS_KEY=请替换
MINIO_SECRET_KEY=请替换

# ---- JWT ----
JWT_SECRET=请替换为随机长字符串

# ---- 大模型 API（至少配置一个）----
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
GLM_API_KEY=

# ---- 腾讯云（正式商用）----
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_COS_BUCKET=
# TENCENT_COS_REGION=ap-guangzhou
# TENCENT_LIVE_DOMAIN=
