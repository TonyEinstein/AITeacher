# ===== 数据库 =====
# 注意：开发环境 PostgreSQL 宿主端口为 5433（见 infra/docker/docker-compose.yml 端口偏移说明）
DATABASE_URL="postgresql://postgres:ai_teacher_dev_2026@127.0.0.1:5433/ai_teacher?schema=public"

# ===== JWT =====
JWT_SECRET=change-me-in-production

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ===== Redis (BullMQ) =====
# 注意：开发环境 Redis 宿主端口为 6380（见 infra/docker/docker-compose.yml 端口偏移说明）
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# ===== MinIO =====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# ===== 边缘端鉴权 =====
# 边缘端上报视觉事件时的 token
EDGE_API_TOKEN=change-me

# ===== LLM（可选，不配则走 mock）=====
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
