# 后端 API 地址
BACKEND_BASE_URL=http://127.0.0.1:3000
# 边缘端鉴权 token（部署时由后端颁发）
EDGE_API_TOKEN=dev-token

# MinIO 配置
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false
MINIO_BUCKET_EVIDENCE=classroom-evidence

# 教室标识（部署时按实际填写）
SCHOOL_ID=1
GRADE_ID=1
CLASS_ID=1
CAMERA_POSITION=front   # front / back

# 摄像头 RTSP 地址（部署时替换）
RTSP_URL=

# 推理参数
CONFIDENCE_THRESHOLD=0.5
FRAMES_FOR_STABLE_BEHAVIOR=8   # 连续 N 帧同行为才确认
GRACE_PERIOD_AFTER_CLASS_START=15  # 上课前 15 分钟 walking 不触发
DEDUP_WINDOW_SEC=300  # 同学生同类违纪 5 分钟内不重复录像
VIDEO_PRE_SEC=10      # 违纪前录 10 秒
VIDEO_POST_SEC=20     # 违纪后录 20 秒
EVIDENCE_RETENTION_DAYS=90
